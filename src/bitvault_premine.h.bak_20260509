// 50,000,000,000 BVT split across 10 wallets, 5B each.
// 1 BVT = 100,000,000 satoshis (8 decimals like Bitcoin)
// 5,000,000,000 BVT = 500,000,000,000,000,000 sats = 5 * 10^17 sats
static constexpr CAmount PREMINE_AMOUNT_PER_WALLET = 500'000'000'000'000'000LL;

// Each entry is a 20-byte witness program (hash160 of the public key).
// scriptPubKey will be P2WPKH: OP_0 <20-byte program>
struct PremineEntry {
    const char* label;
    const char* address_bv;
    uint8_t prog[20];
};

