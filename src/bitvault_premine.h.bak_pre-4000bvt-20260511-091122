// Build a P2WPKH scriptPubKey from a 20-byte witness program.
// Format: OP_0 (0x00) + 0x14 (push 20 bytes) + program
inline CScript BuildP2WPKHScript(const uint8_t prog[20]) {
    CScript s;
    s << OP_0 << std::vector<unsigned char>(prog, prog + 20);
    return s;
